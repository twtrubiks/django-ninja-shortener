# 環境變數範例 —— 複製成 .env 後依環境調整
#
#   cp .env.example .env
#
# 說明：
# - 本機 / Docker 開發可直接沿用以下預設值（與程式內建預設相同），不設定也能跑。
# - 生產環境「務必」覆蓋 DJANGO_SECRET_KEY、DJANGO_DEBUG、DJANGO_ALLOWED_HOSTS
#   以及資料庫帳密，切勿沿用預設值。
# - .env 已被 .gitignore 忽略，不會進版控；本檔（.env.example）才是進版控的範本。

# ── Django 核心 ───────────────────────────────────────────────
# 生產環境請改用隨機長字串，例如：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 注意：此金鑰同時用於 JWT 簽章，外洩等同可偽造任意使用者 token。
DJANGO_SECRET_KEY=django-insecure-&_pxuooakj!0zuj^@vxe-ra^k9iz*r5jxi145#vw9*#4_v@rs_

# 生產環境必須設為 False（否則錯誤頁會洩漏堆疊、SQL、設定值）。
DJANGO_DEBUG=True

# 逗號分隔的允許主機名。生產環境請改成實際網域，例如：
#   DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=*

# ── 生產環境安全（以下僅在 DJANGO_DEBUG=False 時生效）─────────────
# 以下兩個預設值是為本專案的 docker-compose.prod.yml（Caddy 終結 TLS、以純 HTTP
# 回源）量身設定，請勿在該情境下改動，否則會造成 HTTPS 轉址無窮迴圈。
#
# HTTP→HTTPS 自動轉址。Caddy 已負責此轉址且以純 HTTP 回源，故設 False —— 若 Django
# 也開啟，它只會看到 HTTP、不斷回 301，與 Caddy 形成轉址迴圈（ERR_TOO_MANY_REDIRECTS）。
# 只有在「Django 直接對外、沒有前層代理終結 TLS」時才該設為 True。
DJANGO_SECURE_SSL_REDIRECT=False
# HSTS 有效秒數（預設一年）。務必確認整站可長期 HTTPS 後再沿用或加大此值。
DJANGO_SECURE_HSTS_SECONDS=31536000
# 信任反向代理的 X-Forwarded-Proto 標頭來辨識 HTTPS。Caddy 會帶上此標頭，設 True
# 讓 Django 正確辨識 HTTPS（Secure cookie、request.is_secure() 才正常）。
# ⚠️ 僅在「受信任、且會自行覆寫此標頭的代理」後開啟，否則客戶端可偽造協定；
# 本專案 web:8000 只在 compose 內網、不對外發布，由 Caddy 覆寫標頭，故安全。
DJANGO_TRUST_PROXY_SSL_HEADER=True

# ── 生產部署（docker-compose.prod.yml 專用）──────────────────────
# Caddy 對外服務位址。設為你的網域（如 example.com）即啟用自動 HTTPS（Let's Encrypt）；
# 預設 :80 為純 HTTP，僅供本機冒煙測試。
SITE_ADDRESS=:80
# gunicorn worker 數量（建議 2 * CPU 核心數 + 1）。
WEB_CONCURRENCY=3

# ── API 流量限制（throttling）─────────────────────────────────
# 格式「次數/週期」，週期支援 s / m(min) / h(hour) / d(day)。
# 公開端點（QR）按來源 IP；已認證端點按使用者。依部署規模調整。
DJANGO_ANON_THROTTLE_RATE=30/min
DJANGO_USER_THROTTLE_RATE=60/min

# ── PostgreSQL ───────────────────────────────────────────────
# 生產環境請改用強密碼，並確保此處與資料庫服務端設定一致。
POSTGRES_DB=postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password123
POSTGRES_HOST=django-postgres
POSTGRES_PORT=5432
