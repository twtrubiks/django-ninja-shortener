# 環境變數範例 —— 複製成 .env 後依環境調整
#
#   cp .env.example .env
#
# 說明：
# - 本機 / Docker 開發可直接沿用以下預設值（與程式內建預設相同），不設定也能跑。
# - 生產環境「務必」覆蓋 DJANGO_SECRET_KEY、DJANGO_DEBUG、DJANGO_ALLOWED_HOSTS
#   以及資料庫帳密，切勿沿用預設值。
# - .env 已被 .gitignore 忽略，不會進版控；本檔（.env.example）才是進版控的範本。

# ── Django 核心 ───────────────────────────────────────────────
# 生產環境請改用隨機長字串，例如：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 注意：此金鑰同時用於 JWT 簽章，外洩等同可偽造任意使用者 token。
DJANGO_SECRET_KEY=django-insecure-&_pxuooakj!0zuj^@vxe-ra^k9iz*r5jxi145#vw9*#4_v@rs_

# 生產環境必須設為 False（否則錯誤頁會洩漏堆疊、SQL、設定值）。
DJANGO_DEBUG=True

# 逗號分隔的允許主機名。生產環境請改成實際網域，例如：
#   DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=*

# ── PostgreSQL ───────────────────────────────────────────────
# 生產環境請改用強密碼，並確保此處與資料庫服務端設定一致。
POSTGRES_DB=postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password123
POSTGRES_HOST=django-postgres
POSTGRES_PORT=5432
